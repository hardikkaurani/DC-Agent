# DC-Agent Environment Configuration
# Copy this file to .env and configure your values.
# NEVER commit your actual .env file with secrets to Git.

# Primary AI Provider: 'gemini' or 'ollama'
AI_PROVIDER=gemini

# Gemini API Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama Secondary Configuration (optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-coder:latest

# Competitive Programming Profiles
CODEFORCES_USERNAME=hkvariant
LEETCODE_USERNAME=hardikkaurani_

# Persistence
DATABASE_URL=sqlite:///dc_agent.db

# Scheduler Configuration
TIMEZONE=Asia/Kolkata
DAILY_RUN_TIME=17:15
DAILY_POLICY=alternating

# Retry & Execution Limits
RETRY_LIMIT=5
EXECUTION_TIMEOUT=2.0
MEMORY_LIMIT_MB=256

# Execution Sandbox Backend: 'docker' or 'subprocess'
SANDBOX_BACKEND=subprocess
DOCKER_IMAGE=python:3.12-slim

